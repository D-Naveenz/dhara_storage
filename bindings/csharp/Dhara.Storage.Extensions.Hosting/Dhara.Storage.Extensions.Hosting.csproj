<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generic Host integration for Dhara.Storage: starts the `dhara-sd` sidecar with the host and
    stops it during host shutdown, so applications do not need to manage DharaRuntime manually.
    -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <PackageId>Dhara.Storage.Extensions.Hosting</PackageId>
    <Version>0.9.24</Version>
    <Description>Generic Host integration that starts and stops the Dhara Storage sidecar daemon with the application lifetime.</Description>
    <PackageIcon>dhara-logo-colored_sm.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/D-Naveenz/dhara_storage</RepositoryUrl>
    <PackageProjectUrl>https://github.com/D-Naveenz/dhara_storage</PackageProjectUrl>
    <Authors>Naveen Dharmathunga</Authors>
    <PackageTags>storage;hosting;grpc;dependency-injection;rust</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>© 2026 Naveen Dharmathunga and contributors</Copyright>
    <AssemblyTitle>Dhara Storage Hosting Extensions Library</AssemblyTitle>
    <Product>Dhara Storage</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
  </ItemGroup>
  <!-- Prefer packed Dhara.Storage when smoke/verify sets DharaStoragePackageVersion. -->
  <ItemGroup Condition="'$(DharaStoragePackageVersion)' == ''">
    <ProjectReference Include="..\Dhara.Storage\Dhara.Storage.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(DharaStoragePackageVersion)' != ''">
    <PackageReference Include="Dhara.Storage" Version="$(DharaStoragePackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Pack="true" PackagePath="\" Include="README.md" />
    <!-- Same product icon as Dhara.Storage (shared asset; do not duplicate the PNG). -->
    <None Pack="true" PackagePath="\" Include="..\Dhara.Storage\assets\dhara-logo-colored_sm.png" Link="assets\dhara-logo-colored_sm.png" />
  </ItemGroup>
</Project>

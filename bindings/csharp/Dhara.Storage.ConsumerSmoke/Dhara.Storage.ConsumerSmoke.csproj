<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <!-- Set by drot verify package when restoring from a packed local feed; empty uses project references. -->
    <DharaStoragePackageVersion Condition="'$(DharaStoragePackageVersion)' == ''"></DharaStoragePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <!-- Hosting stays a project reference in smoke: verify restores packed Dhara.Storage from the local feed; Hosting is still packed/published by CI beside it. -->
  <ItemGroup>
    <ProjectReference Include="..\Dhara.Storage.Extensions.Hosting\Dhara.Storage.Extensions.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DharaStoragePackageVersion)' == ''">
    <ProjectReference Include="..\Dhara.Storage\Dhara.Storage.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DharaStoragePackageVersion)' != ''">
    <PackageReference Include="Dhara.Storage" Version="$(DharaStoragePackageVersion)" />
  </ItemGroup>
</Project>
